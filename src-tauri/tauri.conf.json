{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DuckTrack",
  "version": "0.1.0",
  "identifier": "com.ducktrack.workspace",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "DuckTrack — Engineering Workspace",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis", "msi", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Local-first engineering workspace",
    "longDescription": "DuckTrack is a local-first engineering workspace: nested projects, an automatic immutable change log, per-task work logs, documentation, portfolio summaries and multi-user support. All data stays on your machine.",
    "publisher": "DuckTrack",
    "category": "DeveloperTool",
    "copyright": "Copyright \u00a9 2026 DuckTrack",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libappindicator3-1"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}